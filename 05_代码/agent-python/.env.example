# ===== python-agent 配置样例（规范 §6.4：密钥/地址全走环境变量，禁硬编码）=====

# java-backend 基础地址（LLM 统一出口：POST {JAVA_BACKEND_URL}/internal/llm/chat）
JAVA_BACKEND_URL=http://localhost:8083

# 服务监听（架构口径：python-agent :8085）
AGENT_HOST=0.0.0.0
AGENT_PORT=8085

# 日志级别（loguru：DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# python→java LLM 网关超时秒（架构口径 60s；java→python /agent/run 为 120s）
LLM_TIMEOUT_SECONDS=60

# 默认 LLM 路由 taskType（java 模型路由层 L6 按 taskType→provider 配置路由）
LLM_TASK_TYPE=agent_reasoning

# 单次 LLM 调用采样参数
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# java /internal/** 内部接口令牌（BE-1.5：必须带 X-Internal-Token 头，否则 401）
INTERNAL_API_TOKEN=

# CrewAI 配置目录（无密钥开关项）：默认 ~/.config/crewai；Windows 受限目录下其
# mkstemp 写探测会阻塞导致 import crewai 卡死，建议指向本地可写目录。
CREWAI_CONFIG_DIR=./crewai_data

# CrewAI 长期记忆存储目录（默认 %LOCALAPPDATA%/CrewAI，不可写时报 SQLite unable to open database file）
CREWAI_STORAGE_DIR=./crewai_data/storage
