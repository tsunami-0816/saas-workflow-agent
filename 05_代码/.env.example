# ============================================================
# saas-workflow-agent 本地环境变量模板（复制为 .env 后填值，禁止提交真实密钥）
# docker compose 与本地启动均按此约定读取；未列出的变量均有 application.yml 开发默认值
# ============================================================

# ---------- java-backend ----------
SERVER_PORT=8083
MYSQL_HOST=localhost
MYSQL_PORT=3310
MYSQL_DB=swa
MYSQL_USER=root
MYSQL_PASSWORD=请填写
REDIS_HOST=localhost
# 本机 Redis 在 6379（离线的 6381 已作废，见 _失败日志 #29）
REDIS_PORT=6379
REDIS_DB=3
REDIS_PASSWORD=
RABBITMQ_HOST=localhost
# 本机 5672/15672 被 rag-rabbitmq 占用，compose 映射到 5673/15673
RABBITMQ_PORT=5673
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=swa-backend-main
PYTHON_AGENT_URL=http://localhost:8085

# JWT 签名密钥：≥32 字节随机串，生产必改
JWT_SECRET=请填写至少32字节随机串
JWT_EXPIRE_HOURS=12

# 内部接口令牌：python-agent 调 /internal/** 时放 X-Internal-Token，生产必改
INTERNAL_API_TOKEN=请填写随机长字符串

# 凭据 AES 密钥：16/24/32 字节 utf8 或 64 位 hex，生产必改
CREDENTIAL_AES_KEY=请填写16或24或32字节或64位hex

# DeepSeek 真实密钥（不配置则 deepseek 路由不可用；可把 llm.routes 指向 *-mock）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=请填写

# DashScope 通义千问（OpenAI 兼容协议；nl2flow/agent_reasoning 默认路由到这里）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=请填写
DASHSCOPE_MODEL=qwen-plus

# LLM 路由与占位单价（每 1K token，元）
LLM_ROUTE_NL2FLOW=dashscope
LLM_ROUTE_AGENT=dashscope
LLM_PRICE_DEEPSEEK=0.002
LLM_PRICE_DASHSCOPE=0.004
LLM_PRICE_OPENAI_MOCK=0.010
LLM_PRICE_CLAUDE_MOCK=0.020

# Worker 并发（M2 压测调优点）
ENGINE_WORKER_CONCURRENCY=16
ENGINE_WORKER_PREFETCH=8

# ---------- python-agent ----------
AGENT_HOST=0.0.0.0
AGENT_PORT=8085
JAVA_BACKEND_URL=http://localhost:8083
LLM_TIMEOUT_SECONDS=60
LLM_TASK_TYPE=agent_reasoning
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3
LOG_LEVEL=INFO
